# Copiez ce fichier en .env et remplissez les valeurs réelles.
# Ne jamais committer le vrai .env (secrets réels) dans le dépôt.

# ─── Base de données ───
MONGODB_URI=
MONGODB_DB_NAME=loka
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=2

# ─── Authentification ───
# Chaîne aléatoire longue (ex: openssl rand -base64 48). Obligatoire en production —
# le serveur refuse de démarrer sans cette variable si NODE_ENV=production.
JWT_SECRET=

# ─── Google Sign-In ───
# Client ID OAuth Web utilisé par Google Identity Services côté frontend.
# Le backend vérifie l'ID token Google avec cette audience.
GOOGLE_CLIENT_ID=

# ─── CORS ───
# Liste des origines autorisées à appeler l'API, séparées par des virgules.
# Par défaut (si absent) : le front GitHub Pages + localhost en dev.
CORS_ORIGINS=https://nellystephane.github.io,http://localhost:5173

# ─── Webhook de confirmation de paiement ───
# Clé partagée avec le fournisseur Mobile Money pour valider les appels au
# webhook PUT /api/paiements/:id/confirmer (voir paiementController.js).
WEBHOOK_SECRET=

# ─── FedaPay (paiement des commandes client ↔ professionnel/particulier) ───
# Distinct de WEBHOOK_SECRET ci-dessus : ce flux concerne l'argent des
# ventes/commandes (section 8), jamais les abonnements (règle transversale n°7).
# FEDAPAY_ENV : "sandbox" (défaut, recommandé pour les tests) ou "live".
FEDAPAY_ENV=sandbox
# Clé secrète du compte FedaPay (dashboard FedaPay > API).
FEDAPAY_SECRET_KEY=
# Clé de signature de l'endpoint webhook (dashboard FedaPay > Webhooks) —
# distincte entre l'environnement sandbox et live.
FEDAPAY_WEBHOOK_SECRET=
# URL de retour optionnelle après paiement (page du front à afficher au client).
FEDAPAY_CALLBACK_URL=https://VOTRE-FRONTEND.example.com/paiement/retour

# ─── Divers ───
NODE_ENV=production
PORT=5000

# ─── Stockage des fichiers (photos, pièces jointes) — section 11.1,
# priorité 8. Sans ces variables : stockage local (server/uploads),
# comportement par défaut inchangé. Avec ces 4 variables renseignées :
# bascule automatique vers S3 (voir utils/stockageFichiers.js).
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optionnel : uniquement pour un service compatible S3 autre qu'AWS
# (Cloudflare R2, Scaleway Object Storage, MinIO auto-hébergé...).
S3_ENDPOINT=
# Optionnel : URL publique de base si différente de l'URL S3 standard
# (ex. domaine CDN devant le bucket).
S3_URL_PUBLIQUE_BASE=

# ─── E-mails transactionnels — section 11.1, priorité 8. Sans ces
# variables : aucun email n'est envoyé (no-op silencieux), comportement
# par défaut inchangé. Compatible avec n'importe quel fournisseur SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Loka <no-reply@loka.example>

# ─── Notifications push (Web Push / VAPID) — section 11.1, priorité 8.
# Générer une paire de clés : npx web-push generate-vapid-keys
# Sans ces variables : aucun push n'est envoyé (no-op silencieux).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@loka.example

# URL du front (sans slash final) — utilisée pour construire les liens
# cliquables dans les emails transactionnels.
FRONTEND_URL=https://VOTRE-FRONTEND.example.com
PUBLIC_APP_URL=https://VOTRE-DOMAINE-PUBLIC.example.com

# Finance / sécurité V11
FUNDS_AVAILABILITY_DELAY_MINUTES=0
ALLOW_PAYMENT_SIMULATION=false
PAYOUT_PROVIDER=fedapay

# ─── Diagnostic d’intégration ───
# Laissez false en production. Le mode test FedaPay doit rester sandbox.
INTEGRATION_DIAGNOSTIC_ENABLED=false
