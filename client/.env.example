# Public API origin; defaults to the production Render API.
VITE_API_URL=https://proxiconnect.onrender.com

# OAuth Web Client ID (public identifier, not the Client Secret). Configure in GitHub Actions secrets.
VITE_GOOGLE_CLIENT_ID=

# Public FedaPay Checkout key only — never put the secret key here.
VITE_FEDAPAY_PUBLIC_KEY=
